{
  "template_repository_url": "https://github.com/defway888-design/kuajing-wulaoshi-weekly-analysis-template",
  "template_repository_visibility": "public",
  "template_manifest_path": "template_manifest.json",
  "data_source_mcp_url": "https://openmcp.lingxing.com/mcp-servers/lingxing-mcp",
  "data_source_mcp_key": "<runtime-secret-only>",
  "output_dir": "<runtime-local-output-directory>",
  "local_path_policy": {
    "do_not_hard_code_user_path": true,
    "forbidden_example": "C:\\Users\\20085\\",
    "windows_user_home_variable": "$env:USERPROFILE",
    "use_codex_default_skill_installation": true
  },
  "mode": "trial",
  "sender_mailbox": {
    "email": "<boss-provided-sender-email>",
    "provider": "<auto-detected-provider>",
    "credential_storage": "<runtime-secure-storage-reference>",
    "test_email_status": "not_tested"
  },
  "management_recipient": {
    "name": "<boss-name-or-remark>",
    "email": "<boss-management-recipient-email>"
  },
  "field_mapping": {
    "strategy": "semantic_mapping_first",
    "record_mapping_to": "字段映射记录",
    "core_blocking_fields": [
      "站点",
      "店铺",
      "父ASIN",
      "当前周期流量",
      "当前周期订单量",
      "上月周期流量",
      "上月周期订单量",
      "周期天数",
      "当前周期日期范围",
      "上月周期日期范围"
    ],
    "auxiliary_non_blocking_fields": [
      "Seller ID",
      "子ASIN",
      "SKU",
      "商品名",
      "负责人",
      "主图",
      "五点",
      "配送类型",
      "站外推广证据",
      "联盟客推广证据",
      "严格相似竞品审核证据"
    ],
    "default_aliases": {
      "父ASIN": ["parent_asin", "asin", "asin1", "parentAsin"],
      "子ASIN": ["asin1", "asin", "child_asin"],
      "SKU": ["seller_sku", "msku", "sku"],
      "Seller ID": ["seller_id", "sid", "sellerId"],
      "流量": ["sessions", "sessions_total", "traffic"],
      "订单量": ["order_count", "volume", "sales", "units_ordered"],
      "商品名": ["product_name", "title", "item_name"],
      "负责人": ["owner", "principal_name", "principal_names"],
      "主图": ["main_image", "image", "image_url"],
      "五点": ["bullet_points", "bullets", "features"],
      "配送类型": ["fulfillment_type", "delivery_type", "fulfillment"]
    }
  },
  "evidence_gap_policy": {
    "non_blocking_gap_status": "可用但有证据缺口",
    "send_status_when_only_auxiliary_gap": "允许发送",
    "gap_type_field": "证据缺口类型",
    "gap_detail_field": "证据缺口说明",
    "non_blocking_gap_types": [
      "Seller ID缺失",
      "主图缺失",
      "五点缺失",
      "配送类型缺失",
      "站外推广证据未闭环",
      "联盟客推广证据未闭环",
      "严格相似竞品审核未闭环"
    ]
  },
  "send_gate": {
    "allow_when_core_status": [
      "完整完成",
      "可用但有证据缺口"
    ],
    "block_when_core_status": [
      "阻断失败",
      "未生成"
    ],
    "requires_validated_tables": true,
    "requires_validated_bi": true,
    "requires_recipient_scope_validation": true
  },
  "high_priority_diagnosis": {
    "enabled_for_status": "高优先级异动",
    "enabled_high_priority_types": [
      "当期高优先异动",
      "缓慢高优先异动"
    ],
    "traffic_skill_repository": "https://github.com/defway888-design/kuajing-wulaoshi-amazon-traffic-anomaly-skil",
    "conversion_skill_repository": "https://github.com/defway888-design/kuajing-wulaoshi-amazon-conversion-anomaly-skill",
    "report_format": "docx",
    "report_output_dir": "<runtime-local-output-directory>/diagnosis_reports/<reporting_period>",
    "diagnosis_index_path": "<runtime-local-output-directory>/高优先级ASIN诊断报告索引.csv",
    "dispatch_rule": {
      "流量异动": "traffic_only",
      "转化率异动": "conversion_only",
      "流量+转化率异动": "traffic_and_conversion_combined"
    }
  },
  "trend_anomaly": {
    "enabled": true,
    "name": "30天双窗口趋势异动",
    "candidate_pool": {
      "traffic_abs_change_min": 0.10,
      "traffic_abs_change_max_exclusive": 0.30,
      "conversion_abs_change_min": 0.20,
      "conversion_abs_change_max_exclusive": 0.50
    },
    "observation_window_days": 30,
    "early_window_days": 7,
    "late_window_days": 7,
    "trend_window_label": "最近30天前7天 vs 后7天",
    "final_status": "高优先级异动",
    "high_priority_type": "缓慢高优先异动",
    "daily_granularity_required": false,
    "middle_days_policy": "not_used_for_compute_control",
    "history_same_window_last_year": true
  },
  "email_packaging": {
    "attachment_threshold_source": "sender_provider_current_official_rule",
    "attachment_safety_ratio": 0.7,
    "boss_default_package": "complete_zip",
    "boss_oversize_package": "light_zip",
    "owner_small_report_mode": "individual_docx_attachments",
    "owner_many_report_mode": "owner_diagnosis_zip"
  },
  "owner_email_map_path": "<runtime-local-owner-email-map.csv>",
  "automation": {
    "enabled": false,
    "start_rule": "Monday 00:00",
    "standard_send_rule": "Monday 09:00",
    "late_send_rule": "send after processing and validation succeed"
  }
}
